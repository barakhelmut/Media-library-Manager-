class ConfigManager:
    def __init__(self, filename="config.json"):
        self.filename = filename
        self.default_config = {
            "server_script": "scripts/serve_site.py",
            "server_port": 8000,
            "server_ready_timeout": 10,
            "server_ready_interval": 0.5,
            "server_url": "http://localhost:8000",
            "auto_open_browser": False,
            "auto_cleanup": True,
            "expected_failures": 4,
            "export_dir": "exports"
        }
        self.config = self.load_config()

    def load_config(self):
        if os.path.exists(self.filename):
            try:
                with open(self.filename, 'r') as f:
                    config = json.load(f)
                # Merge with defaults to ensure all keys exist
                for key, value in self.default_config.items():
                    if key not in config:
                        config[key] = value
                log.info(f"Loaded config from {self.filename}")
                return config
            except Exception as e:
                log.error(f"Error loading config: {e}. Using defaults.")
                return self.default_config.copy()
        else:
            log.info(f"Config file {self.filename} not found. Creating with defaults.")
            self.save_config(self.default_config.copy())
            return self.default_config.copy()

    def save_config(self, config=None):
        if config is None:
            config = self.config
        try:
            with open(self.filename, 'w') as f:
                json.dump(config, f, indent=4)
            log.info(f"Config saved to {self.filename}")
        except Exception as e:
            log.error(f"Error saving config: {e}")

    def update_config(self, key, value):
        self.config[key] = value
        self.save_config()

class SiteBuildManager:
