    def load_config_to_ui(self):
        log.info("Configuration loaded from config.json")
        self.status_var.set("Configuration loaded")

    def start_server(self):
        if self.is_running:
            messagebox.showwarning("Warning", "Server is already running!")
            return
        
        server_script = self.config.get("server_script", "scripts/serve_site.py")
        
        if not os.path.exists(server_script):
            messagebox.showerror("Error", f"Server script not found: {server_script}")
            return
        
        def run_server():
            self.is_running = True
            self.status_var.set("Starting server...")
            self._log("INFO", f"Starting server: {server_script}")
            
            try:
                self.server_process = subprocess.Popen(
                    [sys.executable, server_script],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE
                )
                self._log("INFO", f"Server started (PID: {self.server_process.pid})")
                
                # Wait for server to be ready
                if self._wait_for_server():
                    self.status_var.set("Server is running")
                    self._log("INFO", "Server is ready!")
                else:
                    self._log("ERROR", "Server failed to start or become ready")
                    self.is_running = False
                    self.server_process = None
                    self.status_var.set("Server failed to start")
                    
            except Exception as e:
                self._log("ERROR", f"Error starting server: {e}")
                self.is_running = False
                self.status_var.set("Error starting server")
        
        threading.Thread(target=run_server, daemon=True).start()

    def _wait_for_server(self):
        import urllib.request
        
        url = self.config.get("server_url", "http://localhost:8000")
        timeout = self.config.get("server_ready_timeout", 10)
        interval = self.config.get("server_ready_interval", 0.5)
        
        start = time.time()
        while time.time() - start < timeout:
            if not self.is_running:
                return False
            try:
                response = urllib.request.urlopen(url, timeout=2)
                if response.getcode() == 200:
                    return True
            except (urllib.error.URLError, ConnectionError, OSError):
                time.sleep(interval)
        return False

    def stop_server(self):
        if not self.is_running or not self.server_process:
            messagebox.showwarning("Warning", "Server is not running!")
            return
        
        self._log("INFO", "Stopping server...")
        self.server_process.terminate()
        try:
            self.server_process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.server_process.kill()
            self.server_process.wait()
        
        self.is_running = False
        self.server_process = None
        self.status_var.set("Server stopped")
        self._log("INFO", "Server stopped.")

    def run_smoke_tests(self):
        if not self.is_running:
            messagebox.showwarning("Warning", "Server is not running! Start the server first.")
            return
        
        self._log("INFO", "Running smoke tests...")
        self.status_var.set("Running smoke tests...")
        
        def run_tests():
            try:
                result = subprocess.run(
                    ['make', 'smoke'],
                    capture_output=True,
                    text=True,
                    check=False
                )
                
                output = result.stdout + result.stderr
                self._parse_and_display_tests(output)
                
                if result.returncode != 0:
                    self._log("WARNING", f"Smoke tests completed with return code {result.returncode}")
                else:
                    self._log("INFO", "Smoke tests completed successfully")
                    
            except Exception as e:
                self._log("ERROR", f"Error running smoke tests: {e}")
            
            self.status_var.set("Smoke tests complete")
        
        threading.Thread(target=run_tests, daemon=True).start()

    def run_deploy_check(self):
        self._log("INFO", "Running deploy check...")
        self.status_var.set("Running deploy check...")
        
        def run_check():
            try:
                result = subprocess.run(
                    ['make', 'deploy-check'],
                    capture_output=True,
                    text=True,
                    check=False
                )
                
                output = result.stdout + result.stderr
                self._log("INFO", output)
                
                if result.returncode != 0:
                    self._log("ERROR", "Deploy check failed!")
                    messagebox.showerror("Deploy Check Failed", "The deploy check did not pass.")
                else:
                    self._log("INFO", "Deploy check passed!")
                    messagebox.showinfo("Deploy Check Passed", "The deploy check passed successfully.")
                    
            except Exception as e:
                self._log("ERROR", f"Error running deploy check: {e}")
            
            self.status_var.set("Deploy check complete")
        
        threading.Thread(target=run_check, daemon=True).start()

    def _parse_and_display_tests(self, output):
        self.test_results = []
        self.tree.delete(*self.tree.get_children())
        
        lines = output.strip().split("\n")
        
        for line in lines:
            # Look for test lines like "test_name ... OK" or "test_name ... FAIL"
            match = re.search(r'^\s*(\S+)\s+(OK|FAIL|PASS|ERROR|SKIP)\s*(.*)$', line.strip(), re.IGNORECASE)
            if match:
                test_name = match.group(1)
                status = match.group(2).upper()
                message = match.group(3).strip() if match.group(3) else ""
                
                self.test_results.append({
                    'name': test_name,
                    'status': status,
                    'message': message
                })
                
                # Determine color for status
                if status in ('OK', 'PASS'):
                    color = 'green'
                elif status == 'SKIP':
                    color = 'orange'
                else:
                    color = 'red'
                
                self.tree.insert('', tk.END, values=(test_name, status, message))
                self.tree.tag_configure(color, foreground=color)
                self.tree.set(self.tree.identify('item', *self.tree.bbox(0,0)), 'status', status)

        if not self.test_results:
            # Try to parse summary
            for line in lines:
                if 'passed' in line.lower() and 'failed' in line.lower():
                    pass_match = re.search(r'(\d+)\s+passed', line, re.IGNORECASE)
                    fail_match = re.search(r'(\d+)\s+failed', line, re.IGNORECASE)
                    if pass_match and fail_match:
                        self.test_results.append({
                            'name': 'Summary',
                            'status': f"{pass_match.group(1)}P/{fail_match.group(1)}F",
                            'message': line.strip()
                        })
                        self.tree.insert('', tk.END, values=('Summary', f"{pass_match.group(1)}P/{fail_match.group(1)}F", line.strip()))
                        break

    def _log(self, level, message):
        getattr(log, level.lower())(message)

    def export_json(self):
        if not self.test_results:
            messagebox.showwarning("Warning", "No test results to export!")
            return
        
        filepath = filedialog.asksaveasfilename(
            defaultextension=".json",
            filetypes=[("JSON files", "*.json"), ("All files", "*.*")],
            initialdir=self.config.get("export_dir", "exports")
        )
        
        if filepath:
            try:
                os.makedirs(os.path.dirname(filepath), exist_ok=True)
                with open(filepath, 'w') as f:
                    json.dump(self.test_results, f, indent=4)
                messagebox.showinfo("Success", f"Results exported to {filepath}")
                self._log("INFO", f"Results exported to {filepath}")
            except Exception as e:
                messagebox.showerror("Error", f"Error exporting JSON: {e}")

    def export_csv(self):
        if not self.test_results:
            messagebox.showwarning("Warning", "No test results to export!")
            return
        
        filepath = filedialog.asksaveasfilename(
            defaultextension=".csv",
            filetypes=[("CSV files", "*.csv"), ("All files", "*.*")],
            initialdir=self.config.get("export_dir", "exports")
        )
        
        if filepath:
            try:
                os.makedirs(os.path.dirname(filepath), exist_ok=True)
                with open(filepath, 'w', newline='') as f:
                    writer = csv.DictWriter(f, fieldnames=["name", "status", "message"])
                    writer.writeheader()
                    writer.writerows(self.test_results)
                messagebox.showinfo("Success", f"Results exported to {filepath}")
                self._log("INFO", f"Results exported to {filepath}")
            except Exception as e:
                messagebox.showerror("Error", f"Error exporting CSV: {e}")

    def clear_results(self):
        self.test_results = []
        self.tree.delete(*self.tree.get_children())
        self._log("INFO", "Test results cleared")

    def open_config_window(self):
        config_window = tk.Toplevel(self.root)
        config_window.title("Configuration")
        config_window.geometry("400x500")
        
        ttk.Label(config_window, text="Configuration", font=("Arial", 12, "bold")).pack(pady=10)
        
        config_frame = ttk.Frame(config_window, padding="10")
        config_frame.pack(fill=tk.BOTH, expand=True)
        
        for i, (key, value) in enumerate(self.config.items()):
            ttk.Label(config_frame, text=key.replace("_", " ").title()).grid(row=i, column=0, sticky=tk.W, pady=2)
            if isinstance(value, bool):
                var = tk.BooleanVar(value=value)
                ttk.Checkbutton(config_frame, variable=var).grid(row=i, column=1, sticky=tk.W, pady=2)
                var.trace_add("write", lambda *args, k=key, v=var: self.config.update_config(k, v.get()))
            else:
                ttk.Entry(config_frame, textvariable=tk.StringVar(value=str(value))).grid(row=i, column=1, sticky=(tk.W, tk.E), pady=2)
        
        ttk.Button(config_window, text="Save & Close", command=config_window.destroy).pack(pady=10)
        
        # Make grid responsive
        config_frame.columnconfigure(1, weight=1)
        for i in range(len(self.config)):
            config_frame.rowconfigure(i, weight=1)

def main():
    root = tk.Tk()
    app = SiteBuildManager(root)
    root.protocol("WM_DELETE_WINDOW", lambda: (app.stop_server() if app.is_running else root.destroy()))
    root.mainloop()

if __name__ == "__main__":
    main()
